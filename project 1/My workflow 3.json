    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst channelId = $json.body.channel_id;\n\nif (!staticData.conversations) staticData.conversations = {};\nif (!staticData.conversations[channelId]) staticData.conversations[channelId] = [];\n\nstaticData.conversations[channelId].push({ role: \"user\", content: $json.body.content });\n\nconst systemMsg = {\n  role: \"system\",\n  content: \"You are SlotWise, a booking assistant for a restaurant/salon. Guide the user through: 1) asking if they want a table or an appointment, 2) if it's a table, ask specifically how many people the party will be, and any occasion (birthday, anniversary, casual dinner, etc.); if it's an appointment, ask which service (haircut, facial, manicure), 3) preferred day and time, 4) offer these 3 mock slots: '5:00 PM', '6:30 PM', '8:00 PM', 5) once they pick a slot, ask for their phone number to confirm the booking, 6) once they provide a phone number, confirm with a full summary including party size/service and the phone number. Reply ONLY with valid JSON: {\\\"reply\\\": \\\"...\\\", \\\"status\\\": \\\"in_progress\\\" or \\\"confirmed\\\" or \\\"handoff\\\", \\\"service\\\": \\\"...\\\" or null, \\\"date\\\": \\\"...\\\" or null, \\\"time\\\": \\\"...\\\" or null, \\\"phone\\\": \\\"...\\\" or null}. The 'service' field should include party size if it's a table (e.g. 'Table for 4 - Birthday'). Only set status to 'confirmed' after the phone number has been collected. Use the full conversation history to remember what's already been said — do not repeat questions already answered.\"\n};\n\nconst requestBody = {\n  model: \"llama-3.3-70b-versatile\",\n  messages: [systemMsg, ...staticData.conversations[channelId].slice(-10)]\n};\n\nreturn {\n  json: {\n    requestBody: JSON.stringify(requestBody),\n    channel_id: channelId,\n    author: $json.body.author\n  }\n};"
      },
